# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/

# Visual Studio files
.vs/
.suo
.user
*.ide-workspace

# Cross-platform build results
**/[Bb]in/
**/[Oo]bj/

# nuget
*.nuget.props
*.nuget.targets

appsettings*.json

# Local .terraform directories (contains provider binaries and plugins)
.terraform/

# .tfstate files (contains sensitive data and plain-text secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (likely to contain sensitive passwords, API keys, and secrets)
*.tfvars
*.tfvars.json

# Ignore override files (used to override resources locally)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
